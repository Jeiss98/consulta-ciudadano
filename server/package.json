    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "mysql2": "3.15.3",
    "nodemailer": "7.0.10",
    "pdfkit": "0.17.2",
    "sequelize": "6.37.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "smtp-server": "3.16.1",
    "supertest": "7.1.4"
